#!/bin/sh
set -e

if [ "$1" = configure ]; then
    if [ -f /usr/share/quadrf/functions.sh ]; then
        . /usr/share/quadrf/functions.sh
        install -d -m 755 /var/lib/quadrf/demos
        if getent passwd "${QUADRF_USER}" >/dev/null; then
            chown "${QUADRF_USER}:$(id -gn "${QUADRF_USER}")" /var/lib/quadrf/demos
        fi
        quadrf_user_dropin quadrf-phasegaze.service
    fi
    if [ -x /usr/lib/quadrf/apply.d/46-phasegaze ]; then
        /usr/lib/quadrf/apply.d/46-phasegaze
    fi
fi

#DEBHELPER#
exit 0
